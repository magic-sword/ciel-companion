# デプロイ用スクリプト（scripts/server/*.sh・*.ps1）の接続先。
# このファイルを同じフォルダに .env.local という名前で写し、自分の値を書く（.env.local は Git に入れない）。
# 環境変数で同じ名前を指定した場合はそちらを使う。スクリプトの引数で接続先を渡した場合は引数を使う。

# SSH の接続先（ユーザー名@サーバーのアドレス、または ~/.ssh/config の Host 名）。必須。
CIEL_SERVER_HOST=user@192.168.0.10

# SSH の秘密鍵。空なら ssh の普段の設定（~/.ssh/config や ssh-agent）に任せる。
CIEL_SSH_KEY=
