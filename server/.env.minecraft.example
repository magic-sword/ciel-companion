# このファイルを server/.env.minecraft にコピーして値を入れる（Git に入れない。秘密は書かない）。docs/minecraft-design-ja.md の 12 章。
# 使うとき：docker compose --env-file .env --env-file .env.minecraft --profile minecraft up -d
# マイクラの利用規約（EULA、https://www.minecraft.net/eula）に同意するなら TRUE。同意しないとサーバーは起動しない
MINECRAFT_EULA=
# 持ち主のプレイヤー名（シエルが「ついてきて」の相手にする）
MC_OWNER=
# マイクラのサーバーを開くアドレス（家の中の IPv4 アドレス。例 192.168.1.15）。空ならこのマシンの中だけ
MC_BIND=
