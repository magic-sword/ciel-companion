# 開発用Composeの補間設定。server/.env.devへコピーする（秘密情報はGitに入れない）。
# deploy-remote.sh dev は本番server/.envの後にこのファイルを読み込む。
CIEL_DEV_LLM_BACKEND=local
CIEL_DEV_MODEL=pipeline
CIEL_DEV_INPUT=voice
# STT_BACKENDが空ならlocal時vosk、openai時openai。通常は空のまま。
# INPUT=textにすればモデル不要で文字のみの試験になる。
CIEL_DEV_STT_BACKEND=
CIEL_DEV_VOSK_MODELS_DIR=${HOME}/models/vosk
CIEL_DEV_LOCAL_TIMEOUT=90
CIEL_DEV_DISCORD_WEBHOOK=
