# 開発用Composeの補間設定。server/.env.devへコピーする（秘密情報はGitに入れない）。
# .env.sharedとこのファイルだけを読む。本番の.envは読まない。
CIEL_LLM_BACKEND=local
CIEL_MODEL=pipeline
CIEL_INPUT=voice
# STT_BACKENDが空ならlocal時vosk、openai時openai。通常は空のまま。
# INPUT=textにすればモデル不要で文字のみの試験になる。
CIEL_STT_BACKEND=
CIEL_VOSK_MODELS_DIR=${HOME}/models/vosk
CIEL_VOSK_MODEL_PATH=/models/vosk-model-small-ja-0.22
# CPU Whisperを選ぶ場合はCIEL_STT_BACKEND=whisper。事前にsmallモデルを配置する。
CIEL_WHISPER_MODELS_DIR=${HOME}/models/faster-whisper
CIEL_WHISPER_MODEL_PATH=/models-whisper/small
CIEL_LOCAL_TIMEOUT=90
CIEL_MINUTES_DISCORD_WEBHOOK=
CIEL_LOCAL_ROLES=thought,brief,notes,relationship,growth
