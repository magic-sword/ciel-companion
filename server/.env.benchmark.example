# Copy to .env.benchmark. This is separate from normal Minecraft settings.
# Set TRUE only after accepting the Minecraft EULA.
MINECRAFT_EULA=FALSE
CIEL_BENCH_RCON_PASSWORD=
CIEL_BENCH_BACKEND=local
CIEL_BENCH_MODEL_ID=Qwen3.5-35B-A3B-Q4_K_M
CIEL_BENCH_LOCAL_MODEL=local
CIEL_BENCH_LOCAL_TIMEOUT=600
CIEL_BENCH_LLM_FILE=Qwen3.5-35B-A3B-Q4_K_M.gguf
CIEL_BENCH_LLM_CTX=32768
# Shared GPU API used by Ciel too; no extra model is started by the helper.
CIEL_BENCH_LLM_SERVICE=shared
CIEL_BENCH_LLM_URL=http://127.0.0.1:8094/v1
CIEL_BENCH_LLM_CONTROL=http://127.0.0.1:8095
