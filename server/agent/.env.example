# Python直接起動用。Docker Composeの資格情報はserver/.env.shared、動作設定は環境ごとの.envへ置く。
# このファイルを .env にコピーして値を入れる（.env は Git に入れない）。
# LiveKit Cloud のプロジェクトの Settings → Keys で作る
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# OpenAI の API キー（Realtime API が使えるもの）
OPENAI_API_KEY=

# 本番・開発：文字の推論をすべてローカルへ（既定openai。docs/operations/local-runtime-ja.md）。
# local は CIEL_MODEL=pipeline・CIEL_VOICE=irodori が必要。
# 音声認識はCPUのVoskが既定。画像は対応する共有APIを使う。Web検索・振り分け用の埋め込みは使わない。
# 本番Composeはserver/.envのCIEL_LLM_BACKEND、開発用はserver/.env.devのCIEL_LLM_BACKENDを使う。
# CIEL_LLM_BACKEND=local
# CIEL_LOCAL_LLM_URL=http://127.0.0.1:8094/v1
# APIモデルIDは省略時local。別のIDが必要な場合だけCIEL_LOCAL_LLM_MODELで上書き。
# CIEL_LOCAL_TIMEOUT=90
# CIEL_INPUT=text
# CIEL_INPUT=voice
# CIEL_STT_BACKEND=vosk
# CIEL_VOSK_MODEL_PATH=/models/vosk-model-small-ja-0.22
# CIEL_STT_BACKEND=whisper
# CIEL_WHISPER_MODEL_PATH=/models-whisper/small
# localの音声認識にOpenAIは使わない。モデルは事前に配置する。

# 会話モデル：realtime（既定）または gpt-live
CIEL_MODEL=realtime
# キャラクター設定（省略時は config/persona.toml）。相対パスは server/agent 基準。
# Docker では /app/config 内のファイルを指定する。
CIEL_PERSONA_CONFIG=config/persona.toml
# gpt-realtime-2.1-mini（安い。既定）または gpt-realtime-2.1（高品質）
CIEL_REALTIME_MODEL=gpt-realtime-2.1-mini
# OpenAI の既定の声（フェーズ1。フェーズ2で Seed-VC によりシエルの声へ変換する）
CIEL_OPENAI_VOICE=marin
# マイクの雑音除去（Realtime API）：far_field（少し離れた PC のマイク。既定）、near_field（ヘッドセット）、off
CIEL_NOISE_REDUCTION=far_field
# 話し終わりの判定の早さ（semantic_vad の eagerness：low・medium（既定）・high・auto）
CIEL_EAGERNESS=medium
# 返事の前に会話モデルが考える量（minimal（既定）・low・medium・high。空ならモデルの既定。既定のままだと書き始めが 0.6 秒ほど遅れた）
CIEL_REASONING=minimal
# 返事の声ができるまでの相づち（aizuchi.py。irodori のときだけ）：1（既定）で流す、0 で流さない
CIEL_AIZUCHI=1
# 相手が長く話している途中の息つぎにも相づちを打つ（turns.py）：1（既定）で打つ、0 で打たない
CIEL_NOD=1
# 声：irodori（Irodori-TTS で読み上げ。既定）、ciel（Seed-VC で変換）、openai（変換しない）
CIEL_VOICE=irodori
CIEL_TTS_URL=http://127.0.0.1:8766/synthesize
CIEL_VC_URL=ws://127.0.0.1:8765

# 会議の議事録（minutes.py）。アプリの端末に送り先が登録されていないときに、下書きを送る Discord のチャンネルの Webhook の URL
# （送り先はふつう、アプリの設定画面の「議事録」タブで端末ごとに登録する）
# （利用者だけが見るチャンネルにする。チャンネルの設定 → 連携サービス → ウェブフック）。空なら data/minutes/ に保存する
CIEL_MINUTES_DISCORD_WEBHOOK=
# 議事録を要約する文字のモデル
CIEL_MINUTES_MODEL=gpt-5.4

# その人について覚えておくメモを書く文字のモデル（notes.py）
CIEL_NOTES_MODEL=gpt-5.4-mini
# Web検索（Responses API の web_search を使う）。追加の検索サービスのキーは不要
CIEL_RESEARCH_MODEL=gpt-5.4-mini
# 話者の判定の基準（speakers.py。コサイン類似度。Zoom を通した声で測って調整する）
# CIEL_SPK_MATCH=0.45      # これ以上なら同じ人
# CIEL_SPK_MAYBE=0.35      # これ以上なら「たぶん」
# CIEL_SPK_MARGIN=0.05     # 次に近い人との差がこれ未満なら「たぶん」
# CIEL_SPK_ADAPT=0.60      # これ以上で 2 秒以上の発言は、覚えている人の見本に足す
# CIEL_SPK_MIN_SECONDS=1.0 # 声のある部分がこれより短い発言は判定しない

# YouTube の配信のコメント（youtube_chat.py）。アプリの設定「配信」で配信の URL を入れるとつなぐ。
# Google Cloud のプロジェクトで「YouTube Data API v3」を有効にし、「認証情報 → API キー」で作ったキー（ログインは要らない）。
# キーの制限で「YouTube Data API v3」だけを許可しておく。空なら、アプリで URL を入れても no_key と返す
YOUTUBE_API_KEY=
# コメントを読み直す間隔の下限（秒。1 回 5 単位。1 日 10,000 単位なので、6 秒で約 3 時間分）
# YOUTUBE_POLL_SECONDS=6
