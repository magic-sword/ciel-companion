# このファイルを server/.env にコピーして値を入れる（.env は Git に入れない）。compose.yaml が読む。
# 記録の場所（DB）のパスワード。デプロイのスクリプトは、無ければ自宅サーバーで自動で作る。
CIEL_DB_PASSWORD=

# 本番の推論方式。既定openaiを維持する。localでは共有LLM＋CPUのVosk＋Irodori。
# 詳細・切替前の確認はdocs/local-runtime-ja.md。設定後はagentの再作成が必要。
CIEL_LLM_BACKEND=openai
# 空ならvoice。文字だけの確認ではtextを指定する。
CIEL_INPUT=
# 空ならLLM_BACKENDに連動（local:vosk、openai:openai）。local音声からOpenAIへのフォールバックはない。
CIEL_STT_BACKEND=
CIEL_VOSK_MODELS_DIR=${HOME}/models/vosk
CIEL_VOSK_MODEL_PATH=/models/vosk-model-small-ja-0.22
CIEL_LOCAL_LLM_URL=http://127.0.0.1:8094/v1
CIEL_LOCAL_LLM_MODEL=local
CIEL_LOCAL_TIMEOUT=90
# LOCAL_LLM_DIR等は共有LLMサービス自体の配置設定。agentのbackend変更ではサービスを自動起動しない。
# LOCAL_LLM_DIR=${HOME}/models/llm
